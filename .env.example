# ==============================================================================
# Aqua Fisher v2 — Backend & Infrastructure Environment Template
# Bootstrapped automatically to .env via `make env` or `make bootstrap`.
# NEVER commit .env or production credentials.
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL 16 + TimescaleDB + PostGIS ---
POSTGRES_USER=aqua
POSTGRES_PASSWORD=aqua_dev_password
POSTGRES_DB=aqua_sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aqua:aqua_dev_password@localhost:5432/aqua_sentinel

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- EMQX 5 MQTT Broker ---
EMQX_NODE_COOKIE=aqua_secret_cookie
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_DASHBOARD_PORT=18083
MQTT_INGESTION_USERNAME=aqua_backend_ingestor
MQTT_INGESTION_PASSWORD=change_me_ingestor_secret
EMQX_WEBHOOK_SHARED_SECRET=change_me_webhook_secret

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ROOT_USER=aqua_minio
MINIO_ROOT_PASSWORD=aqua_minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_RAW_MEDIA=aqua-raw-media
MINIO_BUCKET_TWIN_ASSETS=aqua-twin-assets
MINIO_BUCKET_REPORTS=aqua-reports

# --- Photogrammetry (NodeODM) ---
# Host port 3001 avoids colliding with Next.js on 3000; internal Docker port stays 3000
NODEODM_PORT=3001
NODEODM_URL=http://localhost:3001

# --- Human Plane AuthN (Swappable IdP: firebase | oidc) ---
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to Firebase Admin SDK JSON (required for FCM dispatch in Phase 4)
GOOGLE_APPLICATION_CREDENTIALS=
# Used only when AUTH_PROVIDER=oidc (Authentik / Keycloak)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# --- AI Limnologist (apps/workers) ---
OPENAI_API_KEY=